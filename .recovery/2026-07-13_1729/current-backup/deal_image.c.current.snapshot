//        //数目较少位置删除处理
//        if(white_num_L > 50 && white_num_R < 10)
//        {
//            r_found = 0;
//            for (uint8_t i = l_point; i < r_point; i++)
//            {
//                if (imgOSTU[start_center_y][i] == White && imgOSTU[start_center_y][i+1] == Black)
//                {
//                    r_point = i+1;
